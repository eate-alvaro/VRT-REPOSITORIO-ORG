# ---------------------------------------------------------------------------
# Configuracion de entorno - Paintball VR & IoT (React + Vite)
# Copia este archivo como ".env" y completa los valores de Firebase.
# Vite solo expone al navegador las variables con el prefijo VITE_
# ---------------------------------------------------------------------------

# Firebase Web App
# Consola de Firebase > Configuracion del proyecto > Tus apps > App web.
# Requiere habilitar el proveedor Email/Password en Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=alvin-59045.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://alvin-59045-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=alvin-59045
VITE_FIREBASE_STORAGE_BUCKET=alvin-59045.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio sintetico para mapear "usuario" -> "usuario@dominio" en Firebase Auth.
# Permite seguir entrando con un nombre de usuario en lugar de un correo real.
VITE_AUTH_EMAIL_DOMAIN=vrt.local

# Identidad de la aplicacion
VITE_APP_NAME=PAINTBALL VR & IOT
VITE_APP_TAGLINE=PLATAFORMA DE SIMULACION
VITE_APP_VERSION=1.0.0
